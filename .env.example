APP_NAME="Smart Log Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# The setup wizard fills these in; the values below are only defaults.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wazuh_logging
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- OpenSearch / Wazuh indexer ---
# Leave the host empty to run the setup wizard at /setup on first visit.
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_VERIFY=false
OPENSEARCH_TIMEOUT=30
OPENSEARCH_CACHE_TTL=45
OPENSEARCH_INDEX_ALERTS=wazuh-alerts-*
OPENSEARCH_INDEX_MONITORING=wazuh-monitoring-*
OPENSEARCH_INDEX_VULNERABILITIES=wazuh-states-vulnerabilities-*

# --- Seed accounts (only used by php artisan db:seed) ---
APP_ADMIN_NAME="Administrator"
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@wazuh.local
APP_ADMIN_PASSWORD=Admin#2026!secure
